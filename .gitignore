~$*.xlsx
~$*.xls

#################################################
# AMD Business Data
# GitHub에는 프로그램/문서/템플릿만 관리하고,
# 월별 입력자료, 산출물, 백업, 실제 DB는 올리지 않습니다.
#################################################

input/**/*.xlsx
input/**/*.xls

output/*
!output/.gitkeep

backup/*
!backup/.gitkeep

DB/*.xlsx
DB/*.xls
!DB/.gitkeep
!DB/DB_TEMPLATE.xlsx
