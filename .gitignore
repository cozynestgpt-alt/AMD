# Python
__pycache__/
*.py[cod]
*$py.class

# IDE
.vscode/
.idea/

# Virtual Environment
.venv/
venv/
env/

# Windows / macOS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log

# Temporary
*.tmp
*.bak

# Excel temporary files
~$*.xlsx
~$*.xls

#################################################
# AMD Business Data
# GitHub에는 프로그램/문서/템플릿만 관리하고,
# 월별 입력자료, 산출물, 백업, 실제 DB는 올리지 않습니다.
#################################################

input/**/*.xlsx
input/**/*.xls

output/*
!output/.gitkeep

backup/*
!backup/.gitkeep

DB/*.xlsx
DB/*.xls
!DB/.gitkeep
!DB/DB_TEMPLATE.xlsx

# git pull 자동 실행 시 동시 실행 방지용 락 파일 (NAS에서만 생성됨)
.pulling.lock

# templates/ 폴더에 실수로 들어간 실제 산출물 (템플릿 아님, NAS 실무 파일)
templates/더-AMD-260710-06월 판매사원판매수수료(관리 최종)_ver260710.xlsm
templates/정산보고.xlsx
